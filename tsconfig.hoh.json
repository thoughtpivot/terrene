{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": false,
        "module": "ESNext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "noEmit": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "sourceMap": true,
        "strict": false,
        "outDir": "./dist/",
        "paths": {
            "@thoughtpivot/*": ["./src/*"],
            "@thoughtpivot": ["./src"]
        }
    },
    "include": [
        "vite.config.ts",
        "src/main.ts",
        "src/vite-env.d.ts",
        "src/app.ts",
        "src/meta/**/*.ts",
        "src/components/scenes/HeavenOrHell/**/*.ts"
    ],
    "exclude": [".vscode", "node_modules", "dist"]
}
